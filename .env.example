# LOCAL Docker only. Copy to .env and set strong unique values. Never commit the .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
POSTGRES_DB=brewlite
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS

# Local only; switches to simulated WALLET/CARD only if backend DB methods enabled too.
ENABLE_DEMO_PAYMENTS=false
NEXT_PUBLIC_ENABLE_DEMO_PAYMENTS=false
NEXT_PUBLIC_API_URL=http://localhost:4100
LOCAL_FRONTEND_URL=http://localhost:3100,http://127.0.0.1:3100

# ZaloPay Sandbox credentials: get from official sandbox account/config; do not commit.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_AUTO_RECONCILE=true
# Optional local HTTPS tunnel to this LOCAL API only. Never point at Render API.
ZALOPAY_LOCAL_CALLBACK_URL=
ZALOPAY_RETURN_ORIGIN=
