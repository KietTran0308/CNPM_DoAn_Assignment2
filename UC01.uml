@startuml
skinparam backgroundColor white
skinparam style strictuml
skinparam DefaultFontName Arial
skinparam conditionStyle diamond
title Activity Diagram - UC01: Đăng ký

|Khách hàng|
start
:Nhập họ tên, email, mật khẩu;
:Nhấn "Đăng ký";

|Frontend|
:Kiểm tra dữ liệu đầu vào;
if (Dữ liệu hợp lệ?) then (Không)
  :Hiển thị lỗi nhập liệu;
  stop
else (Có)
  :Gửi POST /auth/register;
endif

|Backend (AuthController/Service)|
:Nhận registerDto;
:Truy vấn Database kiểm tra email;

if (Email đã tồn tại?) then (Có)
  :Phát sinh ConflictException;
  :Trả về 409 Conflict;
  |Frontend|
  :Hiển thị thông báo lỗi "Email đã sử dụng";
  stop
else (Không)
  |Backend (AuthController/Service)|
  :Mã hóa mật khẩu;
  :Tạo User mới trong Database;
  :Loại bỏ password khỏi data;
  :Trả về 201 Created;
  |Frontend|
  :Thông báo đăng ký thành công;
  :Chuyển hướng đến Đăng nhập;
  stop
endif
@enduml